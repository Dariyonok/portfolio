---
// "целевая аудитория" panel: one white "infographic" frame (32px/2rem
// padding), 3 equal-width columns with a 20px gap. Each icon placeholder
// is 120×120px (7.5rem), 24px (1.5rem) radius — not circular.
//
// `icon` per card is optional — omit it to keep the dashed "иконка" box.
//
// Two card shapes, same as CompetitorCards' логотипы/плюсы/минусы pair:
//  - `caption` (Медведиум) — one plain paragraph under the icon.
//  - `name` + `difficulties` + `goal` (Easy Buddy: "сложности:"/"цель:";
//    Aistio: "контекст:"/"потребность:", via `difficultiesLabel`/
//    `goalLabel`) — a title (H4: SemiBold 24px/112%, matching every
//    other heading in these panels), then two labeled rows — the label
//    prefix itself is Caption M (16px), the value text after it is the
//    site's regular paragraph style (20px), same split as StatsBox's
//    labels vs. body copy. Give a card one shape or the other, not both.
//    The label text is panel-wide (set once in `Props`, not per card) —
//    every card in one call is describing the same two-part shape.
import RevealText from "../RevealText.astro";
import { nbsp } from "../../lib/text";

interface Card {
  icon?: string;
  iconAlt?: string;
  caption?: string;
  name?: string;
  difficulties?: string;
  goal?: string;
}
interface Props {
  cards: Card[];
  difficultiesLabel?: string;
  goalLabel?: string;
}
const { cards, difficultiesLabel = "сложности:", goalLabel = "цель:" } = Astro.props;
---

<div data-reveal="scale" class="rounded-[2.25rem] bg-white p-[2rem]">
  <div class="grid grid-cols-1 gap-[1.25rem] sm:grid-cols-3">
    {
      cards.map((card) => (
        <div class="flex flex-col items-center gap-[1rem] text-center">
          {card.icon ? (
            <img
              src={card.icon}
              alt={card.iconAlt ?? ""}
              class="h-[7.5rem] w-[7.5rem] rounded-[1.5rem] object-cover"
            />
          ) : (
            <div class="flex h-[7.5rem] w-[7.5rem] items-center justify-center rounded-[1.5rem] border-2 border-dashed border-black/10 bg-black/[0.02] text-[0.75rem] text-black/40">
              иконка
            </div>
          )}
          {card.name ? (
            <div class="flex flex-col gap-[1.25rem]">
              <p class="text-[1.5rem] font-semibold leading-[1.12] text-[#252322]">{nbsp(card.name)}</p>
              <p class="text-[1.25rem] leading-[1.12] text-[#585454]">
                <span class="text-[1rem] uppercase text-[#aaa7a7]">{nbsp(difficultiesLabel)}</span>{" "}
                <RevealText as="span" unit="line" text={nbsp(card.difficulties ?? "")} />
              </p>
              <p class="text-[1.25rem] leading-[1.12] text-[#585454]">
                <span class="text-[1rem] uppercase text-[#aaa7a7]">{nbsp(goalLabel)}</span>{" "}
                <RevealText as="span" unit="line" text={nbsp(card.goal ?? "")} />
              </p>
            </div>
          ) : (
            <RevealText text={nbsp(card.caption ?? "")} unit="line" class="text-[1.25rem] leading-[1.12] text-[#585454]" />
          )}
        </div>
      ))
    }
  </div>
</div>
