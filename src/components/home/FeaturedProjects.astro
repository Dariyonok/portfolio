// Matches Figma "Frame 2087326087" — the 4 large case-study cards.
//
// Each card is a background canvas + a stack of freely-positioned
// ImageLayer images (see ImageLayer.astro) — not a flattened image. Drop
// your own screenshots in by editing a card's `images` array below: `src`
// is the file, `rotate` is its resting tilt, and the `hover*` values are
// where it moves/scales/rotates to when the card is hovered.
//
// `top`/`left`/`width` are PERCENTAGES of the card, not rem — the card
// here renders at 432px wide (27rem, so it fits 3-per-screen in the
// scroller), but the Figma frame this is modeled on is 694px wide, so a
// straight "Figma px ÷ 16" conversion comes out ~62% too large. Percent
// sidesteps that: in Figma, take the image's X/Y/W and divide by the
// *frame's* width (694) or height (517) — e.g. an image at x=140 in a
// 694-wide frame is `left: '20%'` here, no matter what our card's actual
// rendered size is.
import ImageLayer from './ImageLayer.astro'
import RevealText from '../RevealText.astro'
import { nbsp } from '../../lib/text'
import { nonnegative } from 'astro:schema'

// Shared shape for a card's `images` array — every field but `src`/`alt`
// is optional so you only need to set what differs from ImageLayer's
// defaults (see ImageLayer.astro for those).
interface CardImage {
  src?: string
  aspect?: string
  width?: string
  top?: string
  left?: string
  rotate?: number
  hoverX?: string
  hoverY?: string
  hoverRotate?: number
  hoverScale?: number
  shadow?: boolean
  radius?: string
}

