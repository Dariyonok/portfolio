---

<section id="work" class="pb-[4.5rem]">
  <div class="flex flex-col gap-[0.75rem] px-[3.25rem]">
    <RevealText
      text={nbsp('я рада, что стала частью этих проектов')}
      as="p"
      class="text-[1.25rem] uppercase leading-[1.12] text-[#cdcbcb]"
    />
    <RevealText
      text={nbsp(
        'Мы исследовали пользователей, придумывали айдентику и проектировали интерфейс'
      )}
      as="h2"
      class="max-w-[36rem] text-[1.5rem] leading-[1.12] text-[#585454]"
    />
  </div>

  {
    /* Two-row, two-column grid — the 4 cards fill the page width in pairs.
      At the 1512px reference (52px margins, 20px gutter) each card lands
      at exactly 694px, matching the Figma card frame 1:1 — that's also
      why ImageLayer's percentage-based positioning still lines up (see
      ImageLayer.astro). */
  }
  <div
    class="mt-[2.25rem] grid grid-cols-2 gap-x-[1.25rem] gap-y-[1.25rem] px-[3.25rem]"
  >
    {
      projects.map((project, i) => {
        const Tag = project.href ? 'a' : 'div'
        // `bg` can be a plain color string ("#ace5ec") or an image object
        // ({ src: "/images/..." }) — swap between them freely per project.
        const bgStyle =
          typeof project.bg === 'string'
            ? { backgroundColor: project.bg }
            : {
                backgroundImage: `url(${project.bg.src})`,
                backgroundSize: 'cover',
                backgroundPosition: 'center'
              }
        return (
          <Tag
            href={project.href ?? undefined}
            class="featured-card group flex flex-col gap-[1.25rem]"
            data-cursor={project.cursor}
            data-cursor-label={project.cursor === 'soon' ? 'скоро' : undefined}
            data-reveal
            data-reveal-delay={i * 80}
          >
            <div
              class="relative aspect-[694/517] w-full overflow-hidden rounded-[2.25rem]"
              style={bgStyle}
            >
              <div class="absolute left-[1.75rem] top-[1.75rem] rounded-[3.75rem] bg-white/80 px-[1.25rem] py-[0.75rem] text-[1.125rem] leading-[1.12] text-[#585454]">
                {project.year}
              </div>

              {project.images.map((image) => (
                <ImageLayer
                  src={image.src}
                  aspect={image.aspect}
                  width={image.width}
                  top={image.top}
                  left={image.left}
                  rotate={image.rotate}
                  hoverX={image.hoverX}
                  hoverY={image.hoverY}
                  hoverRotate={image.hoverRotate}
                  hoverScale={image.hoverScale}
                  shadow={image.shadow}
                  radius={image.radius}
                  alt={`${project.title} — экран приложения`}
                />
              ))}
            </div>
            <div class="flex flex-col gap-[0.75rem]">
              <p class="text-[2rem] font-semibold leading-[1.12] text-[#252322] sm:text-[3rem]">
                {project.title}
              </p>
              <p class="text-[1.5rem] leading-[1.12] text-[#aaa7a7]">
                {project.subtitle}
              </p>
            </div>
          </Tag>
        )
      })
    }
  </div>
</section>
