---
import RevealText from "../RevealText.astro";
import { nbsp } from "../../lib/text";

// Matches Figma "Frame 2087326075" — 4 smaller one-page/study projects,
// each shown inside a MacBook mockup. The mockup "chrome" (shadow, screen
// frame, body, bevels) is 4 shared exported layers from Figma; only the
// background tint and the on-screen screenshot change per card.
//
// These link out directly to the live sites for now; case study pages for
// them come later (swap `href` to `/work/<slug>/` when those exist).
const cards = [
  {
    screen: "/images/home/small-cards/screen-1.jpg",
    bg: "#717492",
    title: nbsp("Лонгрид о творчестве В. В. Маяковского"),
    href: "https://readymag.com/oleg/thepoeticinnovationofvladimirmayakovsky/",
  },
  {
    screen: "/images/home/small-cards/screen-2.jpg",
    bg: "#bab6c1",
    title: nbsp("Лендинг для умного дерева Reminí"),
    href: "https://readymag.com/oleg/Remini/",
  },
  {
    screen: "/images/home/small-cards/screen-3.jpg",
    bg: "#e4e4de",
    title: nbsp("Сайт курьерской службы ZAP!"),
    href: "https://zap.ae/ru",
  },
  {
    // No link supplied yet for this one — renders unlinked until you have one.
    screen: "/images/home/small-cards/screen-4.jpg",
    bg: "#bcc4bc",
    title: nbsp("Сайт для юриста А. Кукуева"),
    href: null,
  },
];
---

<section class="px-[3.25rem] pb-[4.5rem]">
  <div class="flex flex-col gap-[0.75rem]">
    <RevealText text={nbsp("больше моих работ")} as="p" class="text-[1.25rem] uppercase leading-[1.12] text-[#cdcbcb]" />
    <RevealText
      text={nbsp("Одностраничные сайты и учебные проекты, в которых я работала с дизайном интерфейса")}
      as="h2"
      class="max-w-[36rem] text-[1.5rem] leading-[1.12] text-[#585454]"
    />
  </div>

  <div class="mt-[2.25rem] grid grid-cols-1 gap-x-[1.25rem] gap-y-[1.75rem] sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card) => {
        const Tag = card.href ? "a" : "div";
        return (
          <Tag
            href={card.href ?? undefined}
            target={card.href ? "_blank" : undefined}
            rel={card.href ? "noopener noreferrer" : undefined}
            class="more-projects-card group block"
            data-cursor={card.href ? "view" : undefined}
          >
            <div class="relative h-[13.75rem] w-full overflow-hidden rounded-[1.25rem]" style={{ backgroundColor: card.bg }}>
              {/* The whole mockup assembly scales down on hover; the
                  colored card background stays put. */}
              <div class="absolute left-[7.42%] right-[7.58%] top-[1.75rem] h-[10.3125rem] origin-center transition-transform duration-300 ease-in group-hover:scale-90">
                {/* shadow */}
                <div class="absolute -bottom-[0.46%] -left-[1.35%] -right-[1.35%] top-full">
                  <div class="absolute inset-[-32.88%_0]">
                    <img src="/images/home/small-cards/shadow.svg" alt="" class="block h-full w-full max-w-none" />
                  </div>
                </div>
                {/* screen frame */}
                <div class="absolute inset-[0_8.11%_2.98%_8.11%]">
                  <img src="/images/home/small-cards/screen-frame.svg" alt="" class="absolute inset-0 block h-full w-full max-w-none" />
                </div>
                {/* body */}
                <div class="absolute inset-[94.72%_0_0_0]">
                  <img src="/images/home/small-cards/body.svg" alt="" class="absolute inset-0 block h-full w-full max-w-none" />
                </div>
                {/* bottom */}
                <div class="absolute inset-[97.94%_0_0_0] mix-blend-multiply">
                  <img src="/images/home/small-cards/bottom.svg" alt="" class="absolute inset-0 block h-full w-full max-w-none" />
                </div>
                {/* bevels */}
                <div class="absolute inset-[94.72%_42.7%_3.44%_42.7%] mix-blend-hard-light">
                  <img src="/images/home/small-cards/bevel.svg" alt="" class="absolute inset-0 block h-full w-full max-w-none" />
                </div>
                <div class="absolute inset-[94.72%_42.7%_3.44%_42.7%] mix-blend-multiply">
                  <img src="/images/home/small-cards/bevel-2.svg" alt="" class="absolute inset-0 block h-full w-full max-w-none" />
                </div>
                {/* screenshot */}
                <div class="absolute inset-[5.05%_10%_10.09%_10%] overflow-hidden rounded-[1px]">
                  <img src={card.screen} alt="" class="absolute inset-0 h-full w-full max-w-none object-cover" />
                </div>
                {/* display bottom seam */}
                <div class="absolute inset-[91.74%_8.11%_5.28%_8.11%] bg-[#1b1b1b]" />
              </div>
            </div>

            {/* Caption M: Manrope Regular 18px / 112%, appears 12px below the card on hover. */}
            <p class="mt-[0.75rem] translate-y-[-0.25rem] text-[1.125rem] font-normal leading-[1.12] text-[#585454] opacity-0 transition-all duration-300 ease-in group-hover:translate-y-0 group-hover:opacity-100">
              {card.title}
            </p>
          </Tag>
        );
      })
    }
  </div>
</section>
