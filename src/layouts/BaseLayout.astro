---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

interface Props {
  title: string;
  description?: string;
  headerSticky?: boolean; // forwarded to Header — false on case study pages
  footerCTA?: boolean; // forwarded to Footer — false on case study pages
}

const {
  title,
  description = 'Portfolio of design case studies.',
  headerSticky = true,
  footerCTA = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#f7f6f4] text-neutral-900 antialiased">
    <CustomCursor />
    <ScrollReveal />
    <Header sticky={headerSticky} />
    <main>
      <slot />
    </main>
    <Footer showCTA={footerCTA} />
  </body>
</html>
